DATABASE_URL="postgresql://postgres:postgres@localhost:5432/juzbook?schema=public"
DATABASE_URL_POOLED="postgresql://postgres:postgres@localhost:5432/juzbook?schema=public&connection_limit=20&pool_timeout=30"
# Gemini кілттері. Біріншісінің шектеуі бітсе, жүйе өзі келесісіне көшеді
# (нөмірі шектелмеген: _2, _3, _4 …). Нағыз кілттер тек .env ішінде тұрады.
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
JUZBOOK_SESSION_SECRET="juzbook-local-session-secret-2026"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# "juz40 арқылы кіру" (OAuth). Бұл дерек juz40-edu.kz-тен алынады (олар JUZBOOKS-ты
# OAuth клиент ретінде тіркеп, client_id/secret пен endpoint-тарын береді).
# Осылар толтырылғанда ғана логин бетінде "juz40 арқылы кіру" батырмасы шығады.
JUZ40_CLIENT_ID=""
JUZ40_CLIENT_SECRET=""
JUZ40_AUTHORIZE_URL=""
JUZ40_TOKEN_URL=""
JUZ40_USERINFO_URL=""
JUZ40_SCOPE="openid email profile"
JUZ40_REDIRECT_URI="http://localhost:3000/api/auth/juz40/callback"
# Профиль өрістерінің аты бөлек болса (міндетті емес):
JUZ40_ID_FIELD="sub"
JUZ40_EMAIL_FIELD="email"
JUZ40_NAME_FIELD="name"
JUZ40_SCHOOL_FIELD="school"
JUZ40_GRADE_FIELD="grade"

# Демо аккаунттардың құпиясөздері. Кодта сақталмайды.
# Берілмесе, сол аккаунттың демо-логині істемейді (әдепкі құпиясөз жоқ).
DEMO_STUDENT_PASSWORD=""
DEMO_ADMIN_PASSWORD=""
DEMO_SUPERADMIN_PASSWORD=""
